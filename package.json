{
  "name": "skincare-asmr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && python scripts/optimize-build.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/smoke-test.mjs",
    "build:original": "vite build",
    "package": "npm run build && python scripts/package-build.py",
    "package:adtest": "vite build --mode adtest && python scripts/optimize-build.py && python scripts/package-build.py --adtest",
    "package:original": "npm run build:original && python scripts/package-build.py"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
}
